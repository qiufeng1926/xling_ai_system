# LLM 配置（LLM_PROVIDER: glm | deepseek）
LLM_PROVIDER=glm
# 通用温度（GLM_TEMPERATURE 仍兼容）
LLM_TEMPERATURE=0.3

# 智谱 GLM（LLM_PROVIDER=glm 时必填）
GLM_API_KEY=xxxxxx
GLM_MODEL=glm-4-flash

# DeepSeek（LLM_PROVIDER=deepseek 时必填）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 图文速览（与 Markdown 速览并行生成，可不配，使用下列默认值）
# 生成失败时的重试次数（不含 JSON 修复那一次）
VISUAL_SUMMARY_RETRY_MAX=2
# 转写超过该字数时按段生成图文再合并
VISUAL_CHUNK_CHARS=6000
# 分段之间的重叠字数，避免话题在段边界被截断
VISUAL_CHUNK_OVERLAP=400
# 解析 JSON 失败时是否自动调用 LLM 修复（true/false）
VISUAL_JSON_REPAIR=true
# 同时进行的双轨 LLM 总结上限（实时结束 + 批量上传共存时防阻塞）
LLM_SUMMARY_MAX_CONCURRENT=2

# 运行环境：development | production（生产会强制校验密钥与 API 配置）
APP_ENV=development

# JWT 认证（须与 Information_Aggregation backend 的 SECRET_KEY 保持一致）
JWT_SECRET=dev-local-secret-key-at-least-32-characters-long

# xlink 门户 API（拉取最新权限，默认本机门户后端）
PORTAL_API_URL=http://127.0.0.1:8000
JWT_EXPIRE_HOURS=72

# CORS 允许来源（逗号分隔；xlink 门户开发端口 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://localhost:8000,https://127.0.0.1:8000,https://www.xlink-ai.cn,http://www.xlink-ai.cn,https://xlink-ai.cn,http://xlink-ai.cn

# 批量上传单文件大小上限（字节，默认 100MB）
MAX_UPLOAD_BYTES=104857600

# 启动时自动创建默认用户（生产环境务必 false；首次部署可 POST /api/auth/seed）
SEED_DEFAULT_USERS=false
SEED_ROOT_PASSWORD=
SEED_ADMIN_PASSWORD=

# 通义听悟实时转写（WebSocket 实时会议）
# 在听悟控制台创建项目后获取 AppKey：https://nls-portal.console.aliyun.com/tingwu/projects
ALIBABA_CLOUD_ACCESS_KEY_ID=xxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxxxxxx
TINGWU_APP_KEY=xxxxxxx
TINGWU_REGION=cn-beijing
TINGWU_DOMAIN=tingwu.cn-beijing.aliyuncs.com
TINGWU_SOURCE_LANGUAGE=cn
TINGWU_AUDIO_FORMAT=pcm
TINGWU_SAMPLE_RATE=16000
# 说话人分离：true 开启
TINGWU_DIARIZATION_ENABLED=true
# 说话人数：0=自动识别，2-100=手动指定（可在实时转写页面修改并写回此配置）
TINGWU_DIARIZATION_SPEAKER_COUNT=0

# ASR 配置（批量上传转写，非实时；勿用短名 paraformer-zh/fsmn-vad，易报 not registered）
ASR_MODEL_NAME=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
# 实时 WebSocket 流式转写（本地 FunASR 流式，听悟实时转写可不配）
ASR_STREAMING_MODEL_NAME=iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online
# 语音活动检测 VAD（批量 ASR 必需）
ASR_VAD_MODEL_NAME=damo/speech_fsmn_vad_zh-cn-16k-common-pytorch
# 模型下载源：ms（ModelScope）| hf（HuggingFace）
ASR_MODEL_HUB=ms
# 能量门限：越小越灵敏，易误识别；越大越不易幻听，可能漏字（建议 0.004~0.015）
ASR_ENERGY_THRESHOLD=0.005
ASR_DEVICE=cpu
FFMPEG_PATH=D:\AI\ffmpeg-8.1.1-essentials_build\bin

# 文件路径配置（相对于项目根目录或使用绝对路径）
UPLOAD_DIR=upload
OUTPUT_DIR=output

# ASR 示例文件路径
ASR_EXAMPLE_AUDIO=asr/example/asr_example.wav
ASR_HOTWORD_FILE=asr/example/hotword.txt

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=xxxxxxx
DB_PASSWORD=xxxxxxx
DB_NAME=meeting_ai
DB_CHARSET=utf8mb4
