# 运行环境：development | production
APP_ENV=development

# 服务监听（分布式部署时各节点独立配置）
API_HOST=0.0.0.0
API_PORT=8002

# JWT 认证（须与 Information_Aggregation backend 的 SECRET_KEY 保持一致）
JWT_SECRET=dev-local-secret-key-at-least-32-characters-long
JWT_EXPIRE_HOURS=72

# xlink 门户 API（换取统一 JWT）
# 本地开发：http://127.0.0.1:8000
# Docker 内：http://xlink_influencer_backend:8000（run-flybook 会自动覆盖）
PORTAL_API_URL=http://127.0.0.1:8000

# OAuth 绑定完成后浏览器跳回的前端（须与访问门户的地址一致）
# 本地 Vite：http://localhost:5173
# Docker 门户 :80：http://localhost
# 生产：https://www.xlink-ai.cn
PORTAL_FRONTEND_URL=http://localhost:5173

# 与达人后端 FLYBOOK_INTERNAL_KEY 一致（flybook → 门户内部登录）
FLYBOOK_INTERNAL_KEY=dev-flybook-internal-key-change-me

# CORS 允许来源（逗号分隔）
# 本地开发至少包含 http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# 飞书开放平台（自建应用）
# 在 https://open.feishu.cn/app 创建应用后获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_API_BASE=https://open.feishu.cn

# 飞书网页应用 OAuth（须在开放平台「安全设置 → 重定向 URL」添加相同地址）
# 本地 Vite（npm run dev）：http://localhost:5173/api/flybook/auth/callback
# Docker 门户 :80：http://localhost/api/flybook/auth/callback
# 生产：见 flybook/.env.production.example
FEISHU_OAUTH_REDIRECT_URI=http://localhost:5173/api/flybook/auth/callback
# 可选：授权 scope（云文档需 docx / drive 权限；修改后用户需重新绑定）
# FEISHU_OAUTH_SCOPE=offline_access drive:drive docx:document docx:document:create sheets:spreadsheet sheets:spreadsheet:create base:app:create bitable:app wiki:wiki wiki:node:create docs:document:import drive:file:upload minutes:minutes.search:read minutes:minutes:readonly minutes:minutes.artifacts:read minutes:minutes minutes:minutes.upload:write

# 云文档链接前缀（默认从 FEISHU_MESSENGER_URL 提取租户域名）
# FEISHU_DOC_BASE_URL=https://gcnnna81ata3.feishu.cn
# FEISHU_DOCS_COMPONENT_SDK_URL=https://sf1-scmcdn-cn.feishucdn.com/obj/feishu-static/docComponentSdk/lib/1.0.13.js

# 飞书事件订阅（管理后台「事件订阅」→ 请求地址填 https://your-domain/api/flybook/callback）
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书网页版消息入口（与门户 VITE_FLYBOOK_URL 保持一致即可）
FEISHU_MESSENGER_URL=https://gcnnna81ata3.feishu.cn/next/messenger

# 日志
# LOG_DIR=logs
# LOG_SERVICE_NAME=flybook
# LOG_LEVEL=INFO
