# 开发服务器端口（默认 5173）
# VITE_DEV_PORT=5173

# 开发服务器 HTTPS（默认关闭；cpolar 公网隧道需本地 HTTP。本地测 https://localhost:5173 时设为 true）
# VITE_DEV_HTTPS=true

# 达人后端 API（Vite 代理 /api/v1）
VITE_INFLUENCER_API_TARGET=http://127.0.0.1:8000
# 兼容旧变量名
# VITE_API_TARGET=http://127.0.0.1:8000

# 会议 AI 后端（Vite 代理 /api/auth、/api/meetings、/api/ws、/meeting-app 等）
VITE_MEETING_API_TARGET=http://127.0.0.1:8001

# 飞书后端（Vite 代理 /api/flybook）
VITE_FLYBOOK_API_TARGET=http://127.0.0.1:8002

# 智能体后端（Vite 代理 /api/agent）
VITE_AGENT_API_TARGET=http://127.0.0.1:8003

# 统一登录：meeting_ai / xlink_agent 的 JWT_SECRET 须与 backend SECRET_KEY 相同

# 登录页是否显示注册入口（后端 ALLOW_PUBLIC_REGISTER=false 时注册仍会失败）
VITE_ALLOW_REGISTER=true

# 会议 iframe 嵌入路径（一般无需修改）
VITE_MEETING_APP_PATH=/meeting-app/

# 飞书网页版地址（菜单「飞书」→ /flybook）
VITE_FLYBOOK_URL=https://gcnnna81ata3.feishu.cn/next/messenger
# 兼容旧变量名
# VITE_FEISHU_URL=https://gcnnna81ata3.feishu.cn/next/messenger

# axios 直连后端时使用（默认走 /api/v1 相对路径 + 代理）
# VITE_API_BASE_URL=http://192.168.1.100:8000/api/v1
