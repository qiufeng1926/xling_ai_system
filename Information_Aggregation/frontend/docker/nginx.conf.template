server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker 内置 DNS，避免上游容器重启后 IP 变化导致 502
    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 500m;
    client_body_timeout 3600s;
    send_timeout 3600s;

    # 达人 API
    location /api/v1/ {
        set $influencer_upstream http://${INFLUENCER_API_HOST};
        proxy_pass $influencer_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 会议 AI 批量上传（大文件需更长超时与流式转发）
    location = /api/meeting/upload {
        client_max_body_size 500m;
        client_body_timeout 3600s;
        proxy_request_buffering off;
        set $meeting_upstream http://${MEETING_API_HOST};
        proxy_pass $meeting_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 600s;
        proxy_read_timeout 7200s;
        proxy_send_timeout 7200s;
    }

    # 会议 AI API（与 vite.config.ts 代理规则一致）
    location ~ ^/api/(auth|meeting|meetings|ws|admin|export|settings|notifications)(/|$) {
        set $meeting_upstream http://${MEETING_API_HOST};
        proxy_pass $meeting_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 会议录制 iframe
    location /meeting-app/ {
        set $meeting_upstream http://${MEETING_API_HOST};
        proxy_pass $meeting_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 会议静态资源
    location /static/ {
        set $meeting_upstream http://${MEETING_API_HOST};
        proxy_pass $meeting_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 飞书 API
    location /api/flybook/ {
        set $flybook_upstream http://${FLYBOOK_API_HOST};
        proxy_pass $flybook_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 智能体 API
    location /api/agent/ {
        set $agent_upstream http://${AGENT_API_HOST};
        proxy_pass $agent_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
