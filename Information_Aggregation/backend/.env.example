# 开发环境建议 DEBUG=true；生产环境必须 DEBUG=false 并设置强 SECRET_KEY
# 须与 meeting_ai 的 JWT_SECRET 保持一致（xlink 统一登录）

DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app123
DB_NAME=influencer_db

MYSQL_ROOT_PASSWORD=root

REDIS_URL=redis://localhost:6379/0
DEBUG=true
SECRET_KEY=dev-local-secret-key-at-least-32-characters-long

# 首次启动（无用户时）自动创建管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-run

# 是否开放自助注册（注册后为普通用户）
ALLOW_PUBLIC_REGISTER=true

# 飞书绑定（OAuth 由 flybook 服务处理，须配置相同 FLYBOOK_INTERNAL_KEY）
ALLOW_FEISHU_BIND=true
FLYBOOK_INTERNAL_KEY=dev-flybook-internal-key-change-me
# flybook 服务地址（文档快照同步）
FLYBOOK_API_URL=http://127.0.0.1:8002
# meeting_ai 内部 API（离职交接同步）
MEETING_AI_API_URL=http://127.0.0.1:8001
# 门户调用子服务的内部密钥（与 meeting_ai PORTAL_INTERNAL_KEY / FLYBOOK_INTERNAL_KEY 保持一致）
PORTAL_INTERNAL_KEY=dev-flybook-internal-key-change-me

# 登录限流：60 秒内最多 5 次失败
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# 服务监听与跨域（局域网访问需 API_HOST=0.0.0.0）
API_HOST=0.0.0.0
API_PORT=8000

# 日志（文件命名：{LOG_SERVICE_NAME}_{YYYYMMDD_HHMMSS}.log）
LOG_DIR=logs
LOG_SERVICE_NAME=influencer-api
LOG_MAX_BYTES=10485760
LOG_RETENTION_DAYS=15
LOG_LEVEL=INFO
LOG_CONSOLE=true

# 额外允许的前端来源，逗号分隔
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.xlink-ai.cn,http://www.xlink-ai.cn
# 生产环境可关闭 DEBUG 并显式设置 CORS_ORIGINS / CORS_ORIGIN_REGEX

# 采集模式: mock / api / browser（推荐 Playwright 星图自动化）
COLLECTOR_MODE=browser

# 星图登录态（推荐，运行 scripts/save_xingtu_session.py 生成）
XINGTU_STORAGE_STATE=cookies/xingtu_state.json

# 蒲公英登录态（小红书，运行 scripts/save_pugongying_session.py 生成）
PUGONGYING_STORAGE_STATE=cookies/pugongying_state.json

# 或使用 Cookie 字符串（备选）
XINGTU_COOKIE=
XIAOHONGSHU_COOKIE=
PUGONGYING_COOKIE=
DOUYIN_COOKIE=

# Playwright 配置
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=80
PLAYWRIGHT_WAIT_AFTER_SEARCH=3500
PLAYWRIGHT_FILTER_WAIT=2500
PLAYWRIGHT_MAX_SCROLLS=2
PLAYWRIGHT_MAX_PAGES=10
PLAYWRIGHT_PAGE_SIZE=20
PLAYWRIGHT_DETAIL_ENRICH_MAX=0
PLAYWRIGHT_FALLBACK_MOCK=false

# 星图开放平台 API（可选）
DOUYIN_API_TOKEN=

# 企业微信自建应用（邮件 API path/97504；审批 API path/91982, 91853, 91816, 91983）
WECOM_CORP_ID=
WECOM_CORP_SECRET=

# 每日凌晨全量文件导出（offboarding / 飞书文档快照 / meeting_ai 音频与纪要）
DAILY_EXPORT_ENABLED=true
DAILY_EXPORT_HOUR=3
DAILY_EXPORT_MINUTE=0
# 导出根目录（相对 backend/），其下按日期再分级：exports/YYYY-MM-DD/{offboarding,feishu_documents,meeting_ai}/...
DAILY_EXPORT_ROOT=exports
# meeting_ai 文件目录（默认同仓库 meeting_ai/upload 与 meeting_ai/output）
# MEETING_AI_UPLOAD_DIR=
# MEETING_AI_OUTPUT_DIR=
# WECOM_API_BASE=https://qyapi.weixin.qq.com
# 可选：默认审批模板 ID（在审批模板编辑页 URL 中获取）
# WECOM_DEFAULT_TEMPLATE_ID=
