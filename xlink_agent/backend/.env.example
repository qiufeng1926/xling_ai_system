APP_ENV=development
APP_NAME=xlink-agent
API_HOST=0.0.0.0
API_PORT=8003

# 必须与门户 SECRET_KEY 一致
JWT_SECRET=dev-local-secret-key-at-least-32-characters-long

PORTAL_API_URL=http://127.0.0.1:8000
PORTAL_FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# MySQL（独立库 xlink_agent）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app123
DB_NAME=xlink_agent

# Qdrant
# 开发机（无 Docker）：用 local 嵌入式，数据落在 QDRANT_PATH，无需单独起服务
# 生产机（Docker Compose）：设 QDRANT_MODE=url，QDRANT_URL=http://qdrant:6333
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb_chunks
# 会话摘要向量集合（模糊召回，与知识库隔离）
QDRANT_SESSION_COLLECTION=session_memory
QDRANT_USER_MEMORY_COLLECTION=user_memory
# 余弦相似度阈值（方案默认 0.65）；低于此分不进入候选
SESSION_MEMORY_SCORE_THRESHOLD=0.65
SESSION_MEMORY_TOP_K=6
SESSION_KEEP_USER_TURNS=5
MEMORY_WEIGHT_SAME_TASK=2.0
MEMORY_WEIGHT_RECENT=1.5
MEMORY_WEIGHT_LONG_TERM=1.3
MEMORY_WEIGHT_CHITCHAT=0.5
MEMORY_WEIGHT_ENTITY_BOOST=1.2

# LLM
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_EMBEDDING_MODEL=embedding-2
LLM_TEMPERATURE=0.3
# 瞬态 SSL/连接失败时的重试次数与退避（秒 × attempt）
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SEC=1.5

# Workspace & browser
WORKSPACE_ROOT=./data/workspaces
BROWSER_IDLE_TTL_SEC=1800
AGENT_MAX_UPLOAD_MB=30
BROWSER_HEADLESS=true

# Agent loop：深度调研任务建议 ≥12；过小会导致材料不足就 finish
AGENT_MAX_TOOL_ROUNDS=12
CONFIRMATION_TTL_SEC=600
