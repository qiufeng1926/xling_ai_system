# xlink Docker Compose 环境变量示例
# 复制后修改：cp docker/.env.example docker/.env
#
# 业务密钥（GLM/听悟/飞书等）放在各服务 .env，Compose 会加载并允许此处覆盖基础设施项：
#   meeting_ai/.env
#   flybook/.env
#   Information_Aggregation/backend/.env
#
# 生产部署前请执行：docker/scripts/win/validate-deploy.cmd -Strict

# ---------- 共享密钥（达人 SECRET_KEY = meeting/flybook JWT_SECRET）----------
JWT_SECRET=dev-local-secret-key-at-least-32-characters-long
PORTAL_INTERNAL_KEY=dev-flybook-internal-key-change-me

# ---------- 运行模式 ----------
# development：缺密钥时仅告警；production：flybook/meeting-ai 启动校验失败则退出
APP_ENV=development

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=app_user
MYSQL_PASSWORD=app123
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- 服务端口（宿主机映射）----------
INFLUENCER_API_PORT=8000
MEETING_API_PORT=8001
FLYBOOK_API_PORT=8002
PORTAL_HTTP_PORT=80

# ---------- 门户访问地址（飞书 OAuth 回调等）----------
# 生产示例：PORTAL_FRONTEND_URL=https://www.xlink-ai.cn
PORTAL_FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ---------- 会议 AI（也可仅在 meeting_ai/.env 配置）----------
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-4-flash
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
MAX_UPLOAD_BYTES=524288000

# ---------- 飞书（也可仅在 flybook/.env 配置）----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 生产示例：FEISHU_OAUTH_REDIRECT_URI=https://www.xlink-ai.cn/api/flybook/auth/callback
FEISHU_OAUTH_REDIRECT_URI=http://localhost/api/flybook/auth/callback
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_MESSENGER_URL=

# ---------- 开发调试 ----------
DEBUG=false
