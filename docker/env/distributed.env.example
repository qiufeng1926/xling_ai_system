# xlink 基础设施配置（Docker 网络 / MySQL / Redis / 各服务地址）
# 各业务密钥仍放在各自 .env：
#   meeting_ai/.env
#   Information_Aggregation/backend/.env
#   flybook/.env
# 复制后修改：cp docker/env/distributed.env.example docker/env/distributed.env

# ---------- 镜像 ----------
IMAGE_PREFIX=xlink
IMAGE_TAG=latest

# ---------- 共享密钥（达人 SECRET_KEY = meeting/flybook JWT_SECRET）----------
JWT_SECRET=dev-local-secret-key-at-least-32-characters-long
PORTAL_INTERNAL_KEY=dev-flybook-internal-key-change-me

# ---------- MySQL（基础设施节点或云 RDS 地址）----------
# 【同一台机器 docker run】DB_HOST 填容器名 xlink_mysql
# 【多机 / 本机非容器跑后端】填 MySQL 机器 IP
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=app_user
MYSQL_PASSWORD=app123
DB_HOST=xlink_mysql
DB_PORT=3306
MYSQL_PORT=3306

# ---------- Redis ----------
# 【同一台机器 docker run】REDIS_URL=redis://xlink_redis:6379/0
REDIS_HOST=xlink_redis
REDIS_PORT=6379
REDIS_URL=redis://xlink_redis:6379/0

# ---------- 各服务地址 ----------
# 【同一台机器 + docker network xlink_net】填容器名:
INFLUENCER_API_HOST=xlink_influencer_backend
INFLUENCER_API_PORT=8000
INFLUENCER_API_URL=http://xlink_influencer_backend:8000

# 会议 AI
MEETING_API_HOST=xlink_meeting_ai
MEETING_API_PORT=8001
MEETING_AI_API_URL=http://xlink_meeting_ai:8001

# 飞书
FLYBOOK_API_HOST=xlink_flybook
FLYBOOK_API_PORT=8002
FLYBOOK_API_URL=http://xlink_flybook:8002

# 门户前端（Nginx 反代上游，格式 host:port，无 http://）
PORTAL_HTTP_PORT=80
PORTAL_FRONTEND_URL=http://127.0.0.1
CORS_ORIGINS=http://127.0.0.1,http://localhost

# ---------- 会议 AI / 飞书 / 达人：业务配置请编辑各自目录下的 .env ----------
# 此处仅保留 Docker 编排需要的地址；勿在此重复填写 GLM/听悟/飞书密钥

# ---------- Docker 构建（国内网络建议保留以下配置）----------
# 基础镜像（Docker Hub 超时时用 DaoCloud 加速；海外可改回 python:3.11-slim 等）
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# 达人后端 Playwright 镜像走 MCR，一般无需改
# PLAYWRIGHT_BASE_IMAGE=mcr.microsoft.com/playwright/python:v1.49.1-noble

# pip / npm（清华源在 Docker 内可能 SSL 失败，推荐阿里云）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 数据卷宿主机目录（可选）----------
# 业务数据（upload/output/cookies 等）仍用命名卷；不设 DATA_ROOT 时写入 Docker 卷
# DATA_ROOT=/data/xlink

# 日志目录（可选）：不设则默认绑定到仓库内各服务 logs/
#   meeting_ai/logs
#   Information_Aggregation/backend/logs
#   flybook/logs
# LOGS_ROOT=/data/xlink/logs
